# Copy to .env and fill in. .env is never committed.

# Ports on the host (bound to 127.0.0.1 only). Change if another project already uses them;
# keep VITE_API_URL in sync with PORT.
PORT=4000
CLIENT_PORT=3000
DB_PORT=5432
VITE_API_URL=http://localhost:4000

# Database. POSTGRES_PASSWORD is required — generate one with: openssl rand -hex 16
# Postgres only reads it when the data volume is first created; to change it later use ALTER USER.
POSTGRES_DB=reviewinsight
POSTGRES_USER=reviewinsight
POSTGRES_PASSWORD=
# For running server code on the host (e.g. scripts/); Docker builds its own URL pointing at "db"
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@localhost:${DB_PORT}/${POSTGRES_DB}

# Claude API
ANTHROPIC_API_KEY=
EXTRACT_MODEL=claude-haiku-4-5
# Optional; defaults to EXTRACT_MODEL
CLUSTER_MODEL=

# Review fetching defaults
DEFAULT_COUNTRY=ca
DEFAULT_LANG=en
