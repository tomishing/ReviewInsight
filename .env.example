# Copy to .env and fill in. .env is never committed.

# Database (used by the db container and to build DATABASE_URL for the server container)
POSTGRES_DB=reviewinsight
POSTGRES_USER=reviewinsight
POSTGRES_PASSWORD=reviewinsight
# For running server code on the host (e.g. scripts/); Docker builds its own URL pointing at "db"
DATABASE_URL=postgresql://reviewinsight:reviewinsight@localhost:5432/reviewinsight

# Claude API
ANTHROPIC_API_KEY=
EXTRACT_MODEL=claude-haiku-4-5
# Optional; defaults to EXTRACT_MODEL
CLUSTER_MODEL=

# Review fetching defaults
DEFAULT_COUNTRY=ca
DEFAULT_LANG=en

# Ports on the host. Change if another project already uses them;
# keep VITE_API_URL in sync with PORT, and DATABASE_URL with DB_PORT.
PORT=4000
CLIENT_PORT=3000
DB_PORT=5432
VITE_API_URL=http://localhost:4000
